{
  "name": "dms-cfp",
  "version": "0.4.10",
  "description": "Chrome extension to auto-fill Call for Paper submission forms from SymposiumApp",
  "author": "Rafael Dohms <rafael@doh.ms>",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "preview": "vite build --mode development",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/mustache": "^4.2.5",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "fuzzy": "^0.1.3",
    "mustache": "^4.2.0"
  }
}
